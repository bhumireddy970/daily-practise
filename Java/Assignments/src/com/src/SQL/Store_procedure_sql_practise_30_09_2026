-- get employess details whose salary is greater than something and from some department
DELIMITER //
create procedure  spgetemployeesbasedonconditions(dept varchar(50) , sal int)
begin
	select * from employees
	where department=dept and salary > sal;
end//
DELIMITER
call spgetemployeesbasedonconditions("Finance",60000);