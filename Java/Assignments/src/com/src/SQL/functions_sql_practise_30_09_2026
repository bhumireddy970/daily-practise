select * from employees;

select ucase(employee_name) from employees;

select lcase(employee_name) from employees;

select sum(salary) from employees;

select max(salary) from employees;

select min(salary) from employees;

select avg(salary) from employees;

select employee_id,employee_name, AVG(salary) OVER (PARTITION BY department) AS avg_dept_salary from employees;

SELECT VERSION();


SELECT employee_name,salary,
       CASE WHEN Salary >= 70000 THEN 'High'
            ELSE 'Low' END AS Salary_Level
FROM Employees;